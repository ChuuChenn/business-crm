{
  "name": "business-crm",
  "version": "0.1.0",
  "private": true,
  "description": "Business CRM — CRM + POS + Inventory + Workforce + Finance cho bán lẻ B2C Việt Nam",
  "packageManager": "pnpm@10.28.0",
  "engines": {
    "node": ">=22.12.0",
    "pnpm": ">=10"
  },
  "scripts": {
    "dev": "turbo run dev --parallel",
    "build": "turbo run build",
    "lint": "turbo run lint",
    "typecheck": "turbo run typecheck",
    "test": "turbo run test",
    "test:integration": "turbo run test:integration --concurrency=1",
    "test:e2e": "pnpm --filter @crm/e2e test",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "db:generate": "pnpm --filter @crm/api prisma:generate",
    "db:migrate": "pnpm --filter @crm/api prisma:migrate:deploy",
    "db:migrate:dev": "pnpm --filter @crm/api prisma:migrate:dev",
    "db:seed": "pnpm --filter @crm/api db:seed",
    "docs:permissions": "pnpm --filter @crm/shared gen:permission-doc",
    "infra:up": "docker compose up -d postgres redis minio mailpit",
    "infra:down": "docker compose down"
  },
  "devDependencies": {
    "prettier": "3.9.10",
    "turbo": "2.11.9",
    "typescript": "5.9.3"
  }
}
