# Sao chép thành .env rồi đổi mọi giá trị "change-me". Không commit file .env.
# ---- Hạ tầng (docker compose) ----
POSTGRES_USER=crm
POSTGRES_PASSWORD=change-me-postgres
POSTGRES_DB=crm_dev
POSTGRES_PORT=5432
REDIS_PASSWORD=change-me-redis
REDIS_PORT=6379
S3_ACCESS_KEY=crm-dev
S3_SECRET_KEY=change-me-minio-secret
MINIO_PORT=9000
MINIO_CONSOLE_PORT=9001

# ---- API (apps/api) ----
NODE_ENV=development
PORT=4000
DATABASE_URL=postgresql://crm:change-me-postgres@localhost:5432/crm_dev?schema=public
# Chỉ dùng cho test tích hợp; tên database BẮT BUỘC kết thúc bằng _test.
TEST_DATABASE_URL=postgresql://crm:change-me-postgres@localhost:5432/crm_test?schema=public
REDIS_URL=redis://:change-me-redis@localhost:6379/0
CORS_ORIGINS=http://localhost:3000
LOG_LEVEL=info
S3_ENDPOINT=http://localhost:9000
S3_BUCKET=crm-files
S3_REGION=us-east-1

# ---- Web (apps/web) ----
# URL API mà server Next.js dùng để proxy /api/* (không lộ ra trình duyệt).
API_INTERNAL_URL=http://localhost:4000
